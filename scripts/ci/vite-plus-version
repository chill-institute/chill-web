#!/usr/bin/env bash
set -euo pipefail

manifest_version="$(jq -er '.devDependencies["vite-plus"] // .dependencies["vite-plus"]' package.json)"

case "${manifest_version}" in
  catalog:)
    version="$(
      awk '
        /^catalog:$/ { in_catalog = 1; next }
        in_catalog && /^[^[:space:]]/ { exit }
        in_catalog && /^  vite-plus:[[:space:]]*/ {
          sub(/^  vite-plus:[[:space:]]*/, "")
          gsub(/^["'\'' ]+|["'\'' ]+$/, "")
          print
          exit
        }
      ' pnpm-workspace.yaml
    )"
    ;;
  *)
    version="${manifest_version#^}"
    version="${version#\~}"
    ;;
esac

if [[ ! "${version:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
  echo "Unable to resolve an exact Vite+ version from ${manifest_version}" >&2
  exit 1
fi

printf '%s\n' "${version}"
