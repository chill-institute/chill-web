{
  "name": "@chill-institute/web",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "vp exec playwright install chromium webkit",
    "dev": "vp dev --host 0.0.0.0 --port 58300",
    "build": "vp build && node scripts/check-build.ts",
    "preview": "vp preview --host 0.0.0.0 --port 58300",
    "test": "vp test",
    "check": "vp check && vp exec knip --no-config-hints",
    "smoke": "vp exec playwright test e2e/smoke.spec.ts",
    "e2e": "vp exec playwright test",
    "visual": "vp exec playwright test -c playwright.visual.config.ts",
    "visual:update": "vp exec playwright test -c playwright.visual.config.ts --update-snapshots",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "knip": "vp exec knip --no-config-hints",
    "sst": "sst",
    "verify": "vp run check && vp test && vp run build",
    "prepare": "vp config",
    "quality": "vp run verify && vp run e2e && vp run visual"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@chill-institute/contracts": "2.7.6",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@sentry/react": "^11.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-pattern": "^5.9.0",
    "valibot": "^1.5.0",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@tanstack/router-plugin": "^1.168.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.41.0",
    "sst": "^4.17.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
